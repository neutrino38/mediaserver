[Unit]
Description=IVeS speech-server (ASR, TTS and text correction by Mistral AI)
Documentation=http://www.ives.fr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/ives/bin/speech-server --config /etc/mediaserver/speech-config.json
ExecReload=/bin/kill -HUP $MAINPID

# The Mistral key: systemd copies it into $CREDENTIALS_DIRECTORY, readable by
# this service only. The encrypted variant is a drop-in (see the user guide).
LoadCredential=mistral-api-key:/etc/mediaserver/speech-api.key

# Nothing here needs root: both ports are above 1024.
User=speech
Group=speech
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The key sits in memory: no core dump unless a drop-in asks for one.
LimitCORE=0

# SIGTERM closes the streams (1001), then the Mistral sessions.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

StandardOutput=append:/var/log/speech-server.log
StandardError=append:/var/log/speech-server.log

[Install]
WantedBy=multi-user.target
